# =====================================================================
#  PT Kreatif Sky Abadi — konfigurasi environment
#  Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.
# =====================================================================
APP_NAME="PT Kreatif Sky Abadi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domainanda.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (aaPanel › Database) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kreatifsky
DB_USERNAME=kreatifsky
DB_PASSWORD=

# --- Sesi & keamanan cookie ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Email (untuk reset password & notifikasi pesanan) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@domainanda.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Keamanan aplikasi ---
SECURITY_CSP=true
SECURITY_LOGIN_ATTEMPTS=5
SECURITY_TTE_PIN_ATTEMPTS=5

# --- Seeder (hanya dipakai saat php artisan db:seed pertama kali) ---
# Kosongkan SEED_ADMIN_PASSWORD agar dibuat acak & ditampilkan di terminal.
SEED_ADMIN_EMAIL=admin@kreatifsky.id
SEED_ADMIN_PASSWORD=
SEED_DEMO_AGENT=false

VITE_APP_NAME="${APP_NAME}"
